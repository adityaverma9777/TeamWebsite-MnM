{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/manitya",
      "destination": "/manitya.html"
    },
    {
      "source": "/orbix",
      "destination": "/orbix.html"
    },
    {
      "source": "/orbixclaim",
      "destination": "/orbixclaim.html"
    },
    {
      "source": "/confirmcatalyst",
      "destination": "/confirmcatalyst.html"
    },
    {
      "source": "/eternaluniversity",
      "destination": "/eternaluniversity.html"
    },
    {
      "source": "/id/:id",
      "destination": "/idcard.html"
    }
  ],
  "trailingSlash": false
}
