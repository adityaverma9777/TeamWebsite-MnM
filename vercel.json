{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/competitions", "destination": "/competitions.html" },
    { "source": "/contribute", "destination": "/contribute.html" },
    { "source": "/sponsors", "destination": "/sponsors.html" },
    { "source": "/founders", "destination": "/founders.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/morrow", "destination": "/morrow.html" },
    { "source": "/catalyst", "destination": "/catalyst.html" },
    { "source": "/verifycertificate", "destination": "/verifycertificate.html" },
    { "source": "/manitya", "destination": "/manitya.html" },
    { "source": "/orbix", "destination": "/orbix.html" },
    { "source": "/orbixclaim", "destination": "/orbixclaim.html" },
    { "source": "/confirmcatalyst", "destination": "/confirmcatalyst.html" },
    { "source": "/verifycatalyst", "destination": "/verifycatalyst.html" },
    { "source": "/catalystassistance", "destination": "/catalystassistance.html" },
    { "source": "/eternaluniversity", "destination": "/eternaluniversity.html" },
    { "source": "/communitycatalouge", "destination": "/communitycatalouge.html" },
    { "source": "/communitycatalogue", "destination": "/communitycatalouge.html" },
    { "source": "/community-catalogue", "destination": "/communitycatalouge.html" },
    { "source": "/certificates/catalyst2026/:slug", "destination": "/verifycertificate.html?slug=:slug" },
    { "source": "/id/:id", "destination": "/idcard.html" }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
  "trailingSlash": false
}
