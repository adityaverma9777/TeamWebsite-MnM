{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/ui/fuzzy-critter-footer": ["./componentfooter.tsx"]
    }
  },
  "include": [
    "*.ts",
    "*.tsx",
    "*.js",
    "globals.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}